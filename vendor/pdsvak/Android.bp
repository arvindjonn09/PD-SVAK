// Prebuilt apps preinstalled by PD-SVAK. The APK files are downloaded by
// build/fetch-prebuilts.sh (hash-pinned in prebuilts.lock) and never committed.

android_app_import {
    name: "Accrescent",
    apk: "prebuilt/Accrescent.apk",
    // Keep the developer's own signature, so the app updates itself from its own store.
    presigned: true,
    // Unprivileged on purpose: an app store needs no system permissions to install apps.
    privileged: false,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// Privacy-default overlays. Built as explicit runtime resource overlays rather than
// PRODUCT_PACKAGE_OVERLAYS: the static-overlay route makes Soong auto-generate RROs named
// framework-res__<device>__auto_generated_rro_product, which collide with the identically
// named modules adevtool generates. Resource names are checked by build/check-overlays.sh.
runtime_resource_overlay {
    name: "PdsvakFrameworkOverlay",
    manifest: "rro/framework/AndroidManifest.xml",
    resource_dirs: ["overlay/frameworks/base/core/res/res"],
    product_specific: true,
    sdk_version: "current",
}

runtime_resource_overlay {
    name: "PdsvakUpdaterOverlay",
    manifest: "rro/updater/AndroidManifest.xml",
    resource_dirs: ["overlay/packages/apps/Updater/res"],
    product_specific: true,
    sdk_version: "current",
}
