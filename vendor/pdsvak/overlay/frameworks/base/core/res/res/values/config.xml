<?xml version="1.0" encoding="utf-8"?>
<!-- PD-SVAK privacy defaults for the framework.
     Each name below must exist in frameworks/base/core/res/res/values/config.xml;
     build/check-overlays.sh fails the build if it doesn't. -->
<resources>
    <!-- Network time never comes from Google. Interim (maintainer decision, 2026-11-17): use
         GrapheneOS's server until our own NTP proxy (time.pdsvak.example) is running.
         On the Gold line GrapheneOS itself reads time over HTTPS (config_httpsTimeUrls, also
         time.grapheneos.org); this NTP value is what the LineageOS-based AOSP line uses. -->
    <string-array name="config_ntpServers" translatable="false">
        <item>ntp://time.grapheneos.org</item>
    </string-array>
</resources>
